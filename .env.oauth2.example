# ==============================================================================
# OAuth2-Proxy / CyberArk Identity OIDC Environment Configuration Example
# ==============================================================================
# Copy this file to .env and fill in your OIDC provider credentials.

# 1. Enable OAuth2-Proxy injection inside the container
ENABLE_OAUTH2_PROXY=true

# 2. OIDC Provider Settings (CyberArk Identity, Keycloak, Okta, Authentik, etc.)
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://<tenant_id>.id.cyberark.cloud/oauth2/<app_id>
OAUTH2_PROXY_CLIENT_ID=your_cyberark_client_id
OAUTH2_PROXY_CLIENT_SECRET=your_cyberark_client_secret

# 3. Session Cookie Encryption Secret (must be 16, 24, or 32 bytes)
# Generate with: head -c 32 /dev/urandom | tr -dc 'a-zA-Z0-9'
OAUTH2_PROXY_COOKIE_SECRET=cyberark_simulation_cookie_sec32

# 4. Access Filtering
OAUTH2_PROXY_EMAIL_DOMAINS=*

# 5. Production Security
# Set to true if accessed over HTTPS
OAUTH2_PROXY_COOKIE_SECURE=false
